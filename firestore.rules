rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // ------------------------------------------------------------------
    // ROLE HELPERS (added for Project Work)
    // Employees docs are keyed by auth uid. A legacy doc whose ID is NOT the
    // user's uid fails these checks and is treated as a non-employee -- that
    // fails closed, which is the safe direction. See DEPLOYMENT NOTES.
    // ------------------------------------------------------------------
    function employeeDoc() {
      return get(/databases/$(database)/documents/Employees/$(request.auth.uid));
    }

    function isEmployee() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/Employees/$(request.auth.uid));
    }

    // Mirrors isAdminOrSubAdmin() in lib/employeePortalContext.ts
    function isManager() {
      return isEmployee() &&
             (employeeDoc().data.role == 'admin' || employeeDoc().data.role == 'sub-admin');
    }

    function myEmployeeId() {
      return employeeDoc().data.employeeId;
    }

    // ================================================
    // SYSTEM CONFIG COLLECTION (Work Mode, etc.)
    // ================================================
    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // PERSONAL TODOS COLLECTION (NEW)
    // ================================================
    match /personalTodos/{todoId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // EMPLOYEES COLLECTION
    // ================================================
    match /Employees/{employeeId} {
      allow read: if true;

      // HARDENED: previously `allow write: if isAuthenticated()`, which let any
      // signed-in user set their own role to 'admin' and defeat every
      // role-based rule below. No client code writes this collection (docs are
      // provisioned via console / Admin SDK), so restricting it breaks nothing
      // while making the role checks actually meaningful.
      allow create, delete: if isManager();
      allow update: if isManager() ||
                       (isAuthenticated() &&
                        !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['role', 'employeeId', 'email']));
    }

    // ================================================
    // ATTENDANCE COLLECTION
    // ================================================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // HOLIDAYS COLLECTION
    // ================================================
    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // CALENDAR EVENTS COLLECTION
    // ================================================
    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // TASKS COLLECTION
    // ================================================
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // DISCUSSIONS COLLECTION
    // ================================================
    match /discussions/{discussionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // ACTIVITY LOGS COLLECTION
    // ================================================
    match /activityLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // NOTIFICATIONS COLLECTION (legacy)
    // ================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // USER NOTIFICATIONS COLLECTION (per-user)
    // ================================================
    match /userNotifications/{notificationId} {
      allow read: if isAuthenticated();
      // Allow authenticated writes + public creates for application notifications
      allow create: if isAuthenticated() || request.resource.data.type == 'application';
      allow update, delete: if isAuthenticated();
    }

    // ================================================
    // VIBECODE REGISTRATIONS COLLECTION
    // ================================================
    match /vibecode_registrations/{registrationId} {
      // Allow authenticated users to create registrations
      allow create: if isAuthenticated();
      // Allow authenticated users to read registrations (needed for duplicate check query)
      allow read: if isAuthenticated();
      // Only admins can update or delete
      allow update, delete: if false;
    }

    // ================================================
    // USER PROFILES COLLECTION
    // ================================================
    match /UserProfiles/{userId} {
      // Anyone can read profiles (public profiles need this)
      allow read: if true;
      // Users can create their own profile (once)
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users can update their own profile (restricted fields enforced in app)
      allow update: if isAuthenticated() && request.auth.uid == userId;
      // Users cannot delete profiles
      allow delete: if false;
    }

    // ================================================
    // USERNAMES COLLECTION (username -> uid mapping)
    // ================================================
    match /Usernames/{usernameId} {
      // Anyone can read (needed for public profile lookups & availability checks)
      allow read: if true;
      // Authenticated users can create username mappings
      allow create: if isAuthenticated();
      // Only the owner can update their username mapping
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      // Users cannot delete username mappings
      allow delete: if false;
    }

    // ================================================
    // CAREERS SYSTEM - ROLES COLLECTION
    // ================================================
    match /roles/{roleId} {
      // Anyone can read roles (public careers page reads open roles, employees can read all)
      allow read: if true;
      // Any authenticated user can write (frontend enforces admin-only access)
      allow write: if isAuthenticated();
    }

    // ================================================
    // EVENT ATTENDANCE COLLECTION (QR scanner check-in)
    // ================================================
    match /eventAttendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // CAREERS SYSTEM - APPLICATIONS COLLECTION
    // ================================================
    match /applications/{applicationId} {
      // Anyone can create an application (public apply)
      allow create: if true;
      // Authenticated users who are employees can read and update applications
      // Note: Employee verification is enforced at the app level since
      // employee documents may not always be keyed by auth UID
      allow read, update: if isAuthenticated();
      // No one can delete applications
      allow delete: if false;
    }

    // ================================================
    // HIDDEN MEETINGS COLLECTION (admin-only write)
    // ================================================
    match /hiddenMeetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // REMOVED MEETINGS COLLECTION (per-user removal)
    // ================================================
    match /removedMeetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // MEETING TASK STATUS COLLECTION
    // ================================================
    match /meetingTaskStatus/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // PUSH SUBSCRIPTIONS COLLECTION (Web Push)
    // ================================================
    // Staff devices only. Pushes are sent server-side (Admin SDK), so no
    // client ever needs to read someone else's endpoint. Legacy name-keyed
    // Employees docs are covered by the portalRole claim the server mirrors.
    match /pushSubscriptions/{subscriptionId} {
      allow read, write: if isEmployee() ||
        (isAuthenticated() && 'portalRole' in request.auth.token);
    }

    // ================================================
    // MEETING NOTIFIED COLLECTION (auto-notification tracking)
    // ================================================
    match /meetingNotified/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // MEETING CUSTOM TASKS COLLECTION (admin-added tasks)
    // ================================================
    match /meetingCustomTasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // EVENTS COLLECTION (QR scanner event list)
    // ================================================
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // PUBLIC EVENT VISIBILITY COLLECTION
    // ================================================
    match /eventVisibility/{eventSlug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ================================================
    // CONTACT SUBMISSIONS COLLECTION
    // ================================================
    match /contactSubmissions/{submissionId} {
      // Anyone can create (public contact form)
      allow create: if true;
      // Only authenticated users (admins) can read
      allow read: if isAuthenticated();
      // No updates or deletes from client
      allow update, delete: if false;
    }

    // ================================================
    // LEAVE REQUESTS COLLECTION
    // ================================================
    match /leaveRequests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ================================================
    // SKILLDNA USERS COLLECTION
    // ================================================
    match /skillDNA_users/{userId} {
      // Users can only read their own SkillDNA profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Users can create their own SkillDNA profile
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users can update their own profile
      allow update: if isAuthenticated() && request.auth.uid == userId;
      // Users cannot delete SkillDNA profiles
      allow delete: if false;

      // Version history subcollection
      match /versions/{versionId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // Assessment results subcollection
      match /assessments/{assessmentId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // Activity log subcollection
      match /activityLog/{logId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
    // ================================================
    // LOCATION DATA COLLECTIONS (countries, states, districts)
    // ================================================
    match /countries/{countryId} {
      allow read: if true;
      allow write: if false;
    }

    match /states/{stateId} {
      allow read: if true;
      allow write: if false;
    }

    match /districts/{districtId} {
      allow read: if true;
      allow write: if false;
    }

    // ================================================
    // COLLEGES COLLECTION
    // ================================================
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ================================================
    // COLLEGE REQUESTS COLLECTION
    // ================================================
    match /collegeRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ================================================
    // STUDENTVAULT — OFFERS (public catalog)
    // ================================================
    // Readable by anyone so the public catalog can be served and indexed.
    // ALL writes go through /api/studentvault/* using the Admin SDK, which
    // bypasses these rules after verifying the caller is a matriXO employee.
    // Client writes are denied outright: the Employees collection is itself
    // client-writable, so an `exists(/Employees/$(uid))` check here would be
    // self-grantable by any signed-in user.
    match /studentvault_offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }

    // ================================================
    // STUDENTVAULT — PAID GUIDES
    // ================================================
    // Never client-readable. Guide content is returned only by the server after
    // an entitlement check, so it cannot be scraped by unpaid users.
    match /studentvault_guides/{offerId} {
      allow read: if false;
      allow write: if false;
    }

    // ================================================
    // STUDENTVAULT — ENTITLEMENTS
    // ================================================
    // Owner may read their own entitlement; nobody may write from the client.
    // Granting happens server-side only, after Razorpay signature verification.
    match /studentvault_entitlements/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // ================================================
    // STUDENTVAULT — CLAIM TRACKER (owner-only)
    // ================================================
    match /studentvault_claims/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /items/{offerSlug} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // --- Project Work authorization ------------------------------------
    //
    // IMPORTANT: the `Employees` collection has MIXED document IDs -- some are
    // keyed by Auth UID, others by employee name. Rules cannot run queries, so
    // `get(/Employees/$(request.auth.uid))` silently fails for name-keyed
    // records and would lock those employees (including admins) out entirely.
    //
    // These rules therefore never read `Employees`. They rely only on values
    // carried in the verified auth token:
    //   * request.auth.uid              -- always present, matches assignedToUid
    //   * request.auth.token.portalRole -- a custom claim set server-side by
    //                                      /api/project-work (Admin SDK only,
    //                                      so it cannot be self-granted)
    //
    // All WRITES are denied to clients: every mutation goes through
    // /api/project-work, which resolves identity against both document shapes.

    // Reads the custom claim defensively: the claim is absent until the user's
    // first call to /api/project-work, and touching a missing token key would
    // otherwise abort rule evaluation.
    function portalRole() {
      return isAuthenticated() && 'portalRole' in request.auth.token
        ? request.auth.token.portalRole
        : '';
    }

    function isProjectManager() {
      return isAuthenticated() && (portalRole() == 'admin' || portalRole() == 'sub-admin');
    }

    // ================================================
    // PROJECT WORK (To-Do List -> Project Work)
    // ================================================

    match /projects/{projectId} {
      // Any signed-in portal user may see the project list; managers see the
      // same data plus the management controls in the UI.
      allow read: if isAuthenticated();
      allow write: if false; // server-only, via /api/project-work
    }

    match /projectTasks/{taskId} {
      // Shared visibility: every signed-in employee sees every task and its
      // status. Reading is the ONLY thing this grants -- writes stay closed to
      // clients entirely, so who may start, submit or confirm a task is decided
      // in /api/project-work, not here. A wider read does not widen that.
      allow read: if isAuthenticated();

      allow write: if false; // server-only, via /api/project-work
    }

    match /projectTaskEvents/{eventId} {
      // The audit trail is readable by managers and by the actor themselves.
      allow read: if isProjectManager()
                  || (isAuthenticated() && resource.data.actorUid == request.auth.uid);
      allow write: if false; // append-only, written server-side
    }

    // ================================================
    // PUBLIC NOTIFICATIONS (global, visitor-facing)
    // ================================================
    // Readable by anyone so the public notification feed is accessible
    // without login. ALL writes go through the Admin SDK in API routes.
    match /publicNotifications/{notificationId} {
      allow read: if true;
      allow write: if false;
    }

    // ================================================
    // PUBLIC NOTIFICATION READ STATE (per-user)
    // ================================================
    // Owner may read/write their own read state. Anonymous visitors
    // handle read state client-side via localStorage.
    match /publicNotificationReadState/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}

